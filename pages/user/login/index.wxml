<view class="login-page">
  <!-- 返回按钮 -->
  <!-- <view class="back-button" bindtap="goBack">
    返回
  </view> -->

  <!-- Logo区域 -->
  <view class="logo-section">
    <image class="logo" src="/pages/user/login/1.png" mode="aspectFit"></image>
    <text class="app-name">果冻小衣橱</text>
  </view>

  <!-- 登录区域 -->
  <view class="login-section">
    <view class="wechat-icon" wx:if="{{!loading}}">
      <image src="/pages/user/login/1.png" mode="aspectFit" style="border-radius: 40rpx;"></image>
    </view>

    <text class="login-text" wx:if="{{!loading}}">使用微信授权登录</text>

    <!-- 加载中状态 -->
    <view class="loading-section" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">登录中...</text>
    </view>

    <!-- 三步注册流程 -->
    <block wx:if="{{isLoggedIn && !hasPhone}}">

      <!-- 步骤1：输入昵称 -->
      <block wx:if="{{currentStep === 1}}">
        <text class="login-text">第1步：设置昵称</text>
        <view class="phone-input-group">
          <input
            class="phone-input"
            type="nickname"
            placeholder="点击授权微信昵称"
            value="{{nickname}}"
            bindinput="onNicknameInput"
          />
        </view>
        <button
          class="login-btn wechat-btn"
          bindtap="onNextToAvatar"
        >
          下一步
        </button>
      </block>

      <!-- 步骤2：选择头像 -->
      <block wx:if="{{currentStep === 2}}">
        <text class="login-text">第2步：选择头像</text>
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" style="width:160rpx;height:160rpx;border-radius:50%;margin:20rpx auto;display:block;"></image>
        <button
          class="login-btn wechat-btn"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
        >
          {{avatarUrl ? '重新选择头像' : '选择头像'}}
        </button>
      </block>

      <!-- 步骤3：授权手机号 -->
      <block wx:if="{{currentStep === 3}}">
        <text class="login-text">第3步：授权手机号</text>
        <view style="text-align:center;margin:20rpx 0;">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" style="width:120rpx;height:120rpx;border-radius:50%;"></image>
          <view style="font-size:28rpx;margin-top:10rpx;">{{nickname}}</view>
        </view>
        <button
          class="login-btn wechat-btn"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
          disabled="{{submitting}}"
        >
          {{submitting ? '注册中...' : '授权手机号并注册'}}
        </button>
      </block>

      <button
        bindtap="gotopages"
        style="background-color: #fff;width: 100%;margin-top: 10rpx;border: 1px solid #ccc;height: 45px;line-height: 45px;border-radius: 10rpx;"
      >
        返回主页
      </button>
    </block>

    <!-- 微信一键登录按钮（未登录时显示） -->
    <block wx:if="{{!isLoggedIn && !loading}}">
      <button
        class="login-btn wechat-btn"
        bindtap="retryLogin"
      >
        微信一键登录
      </button>
    </block>
  </view>

  <!-- 用户协议 -->
  <!-- <view class="agreement-section">
    <text class="agreement-text">登录即表示同意</text>
    <text class="agreement-link">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="agreement-link">《隐私政策》</text>
  </view> -->

  <!-- Toast -->
  <t-toast id="t-toast" />
</view>
